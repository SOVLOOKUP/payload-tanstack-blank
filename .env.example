DATABASE_URL=file:./sqlite.db
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Logto (OIDC) login
# https://cloud.logto.io or your self-hosted Logto instance
LOGTO_ENDPOINT=https://your-tenant.logto.app
LOGTO_APP_ID=your-logto-app-id
LOGTO_APP_SECRET=your-logto-app-secret
# At least 32 characters; used to encrypt the Logto session cookie
LOGTO_COOKIE_SECRET=your-logto-cookie-secret-at-least-32-chars
# Optional, defaults to `NODE_ENV === 'production'`
# LOGTO_COOKIE_SECURE=true
