{
  "name": "payload-tanstack-blank",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "payload build --disable-transpile",
    "dev": "bun --bun vite dev",
    "devsafe": "rm -rf .next && vite dev",
    "generate:importmap": "payload generate:importmap --disable-transpile",
    "generate:types": "payload generate:types --disable-transpile",
    "lint": "eslint .",
    "payload": "payload --disable-transpile",
    "start": "vite preview",
    "test": "bun run test:int && bun run test:e2e",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:int": "vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@logto/node": "^3.1.10",
    "@payloadcms/db-sqlite": "4.0.0-canary.28",
    "@payloadcms/graphql": "4.0.0-canary.28",
    "@payloadcms/plugin-mcp": "4.0.0-canary.28",
    "@payloadcms/richtext-lexical": "4.0.0-canary.28",
    "@payloadcms/tanstack-start": "4.0.0-canary.28",
    "@payloadcms/translations": "4.0.0-canary.28",
    "@payloadcms/ui": "4.0.0-canary.28",
    "@tanstack/react-router": "1.170.29",
    "@tanstack/react-start": "1.168.46",
    "cookie": "1.0.2",
    "cross-env": "10.1.0",
    "graphql": "^17.0.2",
    "payload": "4.0.0-canary.28",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sass": "^1.102.0",
    "sharp": "0.35.3",
    "vite": "^8.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.2",
    "@types/bun": "^1.3.14",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "^10.8.1",
    "jsdom": "30.0.1",
    "prettier": "^3.9.6",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "bun": "1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "trustedDependencies": [
    "sharp",
    "esbuild",
    "unrs-resolver",
    "workerd"
  ]
}
